pdxmesh = {
	name = "premodern_05_mesh"
	file = "premodern_05.mesh"

	scale = 1.5

lod_percentages = {
		lod = { index = 1 percent = 7.0 }
		lod = { index = 2 percent = 4.0 }
	}

	meshsettings = {
		name = "mesh0"
		index = 0
		shader = "standard"
		additional_shader_defines = { "PDX_MESH_SNAP_VERTICES_TO_TERRAIN" "EMISSIVE_NIGHT" "EMISSIVE_NIGHT_RANDOM" "SOL_VISUALS" "HUB_BUILDING" }
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "decel0"
		index = 0
		texture_diffuse = "modern_decel.dds"
		# texture_diffuse = "decal_urban_residential_01_diffuse.dds"
		# texture_normal = "decal_urban_residential_01_normal.dds"
		# texture_specular = "decal_urban_residential_01_properties.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}

	meshsettings = {
		name = "world0"
		index = 0
		texture_diffuse = "european_decal_city_diffuse.dds"
		# texture_diffuse = "modern_world_3.dds"
		texture_normal = "european_decal_city_normal.dds"
		texture_specular = "european_decal_city_properties.dds"
		texture = { file = "decal_city_mask_01.dds" index = 3 }
		shader = "decal_world"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "Decals"
	}


	meshsettings = {
		name = "decel1"
		index = 0
		# texture_diffuse = "decal_urban_residential_01_diffuse.dds"
		# texture_normal = "decal_urban_residential_01_normal.dds"
		# texture_specular = "decal_urban_residential_01_properties.dds"
		texture_diffuse = "modern_decel.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}

	meshsettings = {
		name = "world1"
		index = 0
		texture_diffuse = "european_decal_city_diffuse.dds"
		# texture_diffuse = "modern_world_3.dds"
		texture_normal = "european_decal_city_normal.dds"
		texture_specular = "european_decal_city_properties.dds"
		texture = { file = "decal_city_mask_01.dds" index = 3 }
		shader = "decal_world"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "Decals"
	}

	meshsettings = {
		name = "decel2"
		index = 0
		# texture_diffuse = "decal_urban_residential_01_diffuse.dds"
		# texture_normal = "decal_urban_residential_01_normal.dds"
		# texture_specular = "decal_urban_residential_01_properties.dds"
		texture_diffuse = "modern_decel.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}

	meshsettings = {
		name = "world2"
		index = 0
		# texture_diffuse = "european_decal_city_diffuse.dds"
		texture_diffuse = "modern_world_4.dds"
		texture_normal = "european_decal_city_normal.dds"
		texture_specular = "european_decal_city_properties.dds"
		texture = { file = "decal_city_mask_01.dds" index = 3 }
		shader = "decal_world"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "Decals"
	}
}

entity = {
	name = "premodern_05_entity"
